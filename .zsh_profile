export XDG_CONFIG_HOME="$HOME/.config"
# export XDG_CURRENT_DESKTOP="GNOME"

# make nvim default
export EDITOR="nvim"
export TERMINAL="kitty"

# Path Configuration
export GOPATH="$HOME/go"
export PATH="/opt/nvim:$HOME/.local/bin:$HOME/.local/bin/scripts:/usr/local/go/bin:$GOPATH/bin:$PATH"

# Ensure PATH has unique entries
typeset -U path

# helpful alias
alias vim='nvim'
alias cat='bat'
alias lg='lazygit'
alias ld='lazydocker'
alias zconf='nvim ~/.zshrc'
alias zpconf='nvim ~/.zsh_profile'

# Config File Shortcuts
alias i3c='nvim ~/.config/i3/config'
alias muxc='nvim ~/.config/tmux/tmux.conf'
alias picomc='nvim ~/.config/picom/picom.conf'
alias polyc='nvim ~/.config/polybar/config.ini'
alias kittyc='nvim ~/.config/kitty/kitty.conf'
alias vimc='nvim ~/.config/nvim/lua/plugins/ui.lua'
alias bsconf='nvim ~/.bashrc' # make nvim default
alias hlc='nvim ~/.config/hypr/hyprland.conf'

# System Utilities
alias sctl='systemctl'
alias sctls='systemctl status'
alias wific='nmtui' # loads terminal ui for wifi management
alias soz='source ~/.zshrc' # reload .zshrc
alias root='sudo -i' # tune sudo and su
alias lopack='pacman -Qdtq' # list orphaned packages
alias rmopack='sudo pacman -Rs $(pacman -Qdtq)' # remove orphaned packages
alias ycp='yay -Sc' # clean yay packages
alias ylp='yay -Ps' # list installed packages in yay
alias ssh='kitten ssh '
alias upmirrors='sudo reflector --country GB,FR,DE --latest 10 --protocol https,http --sort rate --save /etc/pacman.d/mirrorlist'

# Utilities commands
alias md='mkdir -pv' # create parent directory on demand
alias cpv='rsync -ah --info=progress2' # copy with progress bar
# alias echopl="echo $PATH | tr : \\n"
alias path='echo -e ${PATH//:/\\n}'
alias now='date +"%Y-%m-%d %H:%M:%S"' # Corrected date format

# ls enhancements
# alias l='ls -lF'
# alias ll='ls -alF'
# alias la='ls -A'

# eza enhancements
alias l='eza --color=always --icons --git --no-quotes --group-directories-first -l -F --sort name'
alias ll='eza --color=always --icons --git --no-quotes --group-directories-first -a -l -F --sort name'
alias la='eza --color=always --icons --git --no-quotes --group-directories-first -A --sort name'

# safer rm, mv, cp, ln
alias rm='rm -I --preserve-root'
alias mv='mv -i'
alias cp='cp -i'
alias ln='ln -i'

# docker
alias dbl='docker build'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias dpu='docker pull'
alias dsta='docker stop $(docker ps -q)'
alias dsts='docker stats'
alias dtop='docker top'

#container
alias dr='docker container run'
alias drit='docker container run -it'
alias drs='docker container restart'
alias dcin='docker container inspect'
alias dcls='docker container ls'
alias dclsa='docker container ls -a'
alias dcprune='docker container prune'
alias dlo='docker container logs'
alias dpo='docker container port'
alias dst='docker container start'
alias dxc='docker container exec'
alias dxcit='docker container exec -it'
alias dstp='docker container stop'

#image
alias dib='docker image build'
alias dii='docker image inspect'
alias dils='docker image ls'
alias dipru='docker image prune -a'
alias dipu='docker image push'
alias dirm='docker image rm'
alias dit='docker image tag'

#network
alias dnc='docker network create'
alias dncn='docker network connect'
alias dndcn='docker network disconnect'
alias dni='docker network inspect'
alias dnls='docker network ls'
alias dnprune='docker network prune'
alias dnrm='docker network rm'
alias dsprune='docker system prune'

#volume
alias dvi='docker volume inspect'
alias dvls='docker volume ls'
alias dvprune='docker volume prune'

#docker compose
alias dco=docker-compose
alias dcps='docker-compose ps'
alias dcstart='docker-compose start'
alias dcstop='docker-compose stop'
alias dcsts='docker-compose stats'
alias dcup='docker-compose up'
alias dcupb='docker-compose up --build'
alias dcupd='docker-compose up -d'
alias dcupdb='docker-compose up -d --build'
alias dcdn='docker-compose down'
alias dcb='docker-compose build'
alias dcc='docker-compose config'
alias dci='docker-compose images'
alias dck='docker-compose kill'
alias dcl='docker-compose logs'
alias dclF='docker-compose logs -f --tail 0'
alias dcpull='docker-compose pull'
alias dcr='docker-compose run'
alias dcrestart='docker-compose restart'
alias dcrm='docker-compose rm'
alias dcv='docker-compose version'

# zsh enhancements
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
bindkey '^ ' autosuggest-accept

bindkey -M emacs '^P' history-substring-search-up
bindkey -M emacs '^N' history-substring-search-down
